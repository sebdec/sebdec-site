---
import BaseLayout from './BaseLayout.astro';

interface PostFrontmatter {
	title: string;
	description: string;
	date: string;
	dateValue: string;
}

const { frontmatter } = Astro.props as { frontmatter: PostFrontmatter };
---

<BaseLayout title={`${frontmatter.title} | Sebdec`} description={frontmatter.description}>
	<article class="post">
		<header class="post-header">
			<h1>{frontmatter.title}</h1>
			<time datetime={frontmatter.dateValue}>{frontmatter.date}</time>
		</header>

		<div class="post-content">
			<slot />
		</div>
	</article>
</BaseLayout>

<script>
	const tableOfContents = document.querySelector('.post-toc');

	if (tableOfContents) {
		const links = Array.from(tableOfContents.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
		const sections = links
			.map((link) => document.getElementById(link.hash.slice(1)))
			.filter((section): section is HTMLElement => section !== null);

		const updateCurrentSection = () => {
			let currentSection: HTMLElement | undefined;

			for (const section of sections) {
				if (section.getBoundingClientRect().top > 96) break;
				currentSection = section;
			}

			for (const link of links) {
				if (currentSection && link.hash === `#${currentSection.id}`) {
					link.setAttribute('aria-current', 'location');
				} else {
					link.removeAttribute('aria-current');
				}
			}
		};

		updateCurrentSection();
		document.addEventListener('scroll', updateCurrentSection, { passive: true });
	}
</script>
