---
import Analytics from '@vercel/analytics/astro';
import { faLinkedinIn } from '@fortawesome/free-brands-svg-icons';
import { Github, Strava } from 'simple-icons-astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const [linkedinWidth, linkedinHeight, , , linkedinPath] = faLinkedinIn.icon;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			(() => {
				const storageKey = 'sebdec.analytics.disabled';
				const url = new URL(window.location.href);
				const analyticsPreference = url.searchParams.get('analytics');

				try {
					if (analyticsPreference === 'off') {
						localStorage.setItem(storageKey, 'true');
					} else if (analyticsPreference === 'on') {
						localStorage.removeItem(storageKey);
					}
				} catch {
					// Keep analytics enabled when browser storage is unavailable.
				}

				if (analyticsPreference === 'off' || analyticsPreference === 'on') {
					url.searchParams.delete('analytics');
					history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
				}

				window.webAnalyticsBeforeSend = (event) => {
					try {
						return localStorage.getItem(storageKey) === 'true' ? null : event;
					} catch {
						return event;
					}
				};
			})();
		</script>
		<Analytics />
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<a class="identity" href="/" aria-label="Sebdec, home">Sebdec</a>
			</header>

			<main>
				<slot />
			</main>

			<footer class="site-footer">
				<nav class="social-links" aria-label="Social profiles">
					<a href="https://github.com/sebdec" aria-label="GitHub" title="GitHub">
						<Github size={18} fill="currentColor" aria-hidden="true" />
					</a>
					<a href="https://www.linkedin.com/in/sebdec/" aria-label="LinkedIn" title="LinkedIn">
						<svg
							width="18"
							height="18"
							viewBox={`0 0 ${linkedinWidth} ${linkedinHeight}`}
							fill="currentColor"
							aria-hidden="true"
						>
							<path d={linkedinPath as string}></path>
						</svg>
					</a>
					<a href="https://www.strava.com/athletes/29199412" aria-label="Strava" title="Strava">
						<Strava size={18} fill="currentColor" aria-hidden="true" />
					</a>
				</nav>
				<p>© 2026 Sebdec</p>
			</footer>
		</div>
	</body>
</html>
